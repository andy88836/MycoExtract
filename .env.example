# MycoExtract API Key Configuration
# Copy this file to .env and fill in your API keys

# Moonshot (Kimi) - Student model 1
export MOONSHOT_API_KEY='your-moonshot-api-key-here'

# DeepSeek - Student model 2
export DEEPSEEK_API_KEY='your-deepseek-api-key-here'

# ZhipuAI (GLM) - legacy/development vision model
export ZHIPUAI_API_KEY='your-zhipuai-api-key-here'

# OpenAI (GPT) - legacy/development teacher model or compatible relay
export OPENAI_API_KEY='your-openai-api-key-here'
export OPENAI_BASE_URL='https://api.openai.com/v1'

# MiniMax - Student model 3
export MINIMAX_API_KEY='your-minimax-api-key-here'
export MINIMAX_BASE_URL='https://api.minimaxi.com/v1'

# MiMo - manuscript table-image and aggregation models
export MIMO_API_KEY='your-mimo-api-key-here'
export MIMO_BASE_URL='https://token-plan-sgp.xiaomimimo.com/v1'
